rules_version = '2';

// Temporary client lockdown for the (default) database.
// Known model: Users/{uid} contains account email, name, role, status, and
// vendorID; Users/V001 is a separate vendor-style document. The mobile app's
// other paths and queries are unknown because its source is on another laptop.
//
// No client reads or writes are permitted, including authenticated users and
// subcollections. The web API uses the Admin SDK, which bypasses these rules
// and enforces its own Firebase token and server-side UID allowlist.
// Replace this rule only after the mobile data model and access patterns are
// reviewed and tested. Re-enabling mobile access requires a separate release.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
