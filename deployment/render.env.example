# REFERENCE ONLY. Do not bulk-import: preserve populated Firebase values/admin UIDs.
# Empty values below are documentation placeholders, never replacement settings.
NODE_ENV=production
# Bounded supported major; select/test a fixed patch before release if required.
NODE_VERSION=22.x
SERVE_WEB=true
PRODUCTION_RELEASE_MANIFEST=/etc/secrets/production-release.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/render-readonly-pilot.json
FIREBASE_PROJECT_ID=com-slaughterhouse-app
MUNICIPAL_SCOPE_ID=ph-quezon-calauag
MUNICIPALITY_NAME=Calauag
WEB_ADMIN_UIDS=
CURSOR_SIGNING_SECRET=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=com-slaughterhouse-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=com-slaughterhouse-app
VITE_FIREBASE_STORAGE_BUCKET=com-slaughterhouse-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
ACCOUNT_MANAGEMENT_ENABLED=false
ANIMAL_WORKFLOW_ENABLED=false
ANIMAL_OPERATIONS_ENABLED=false
# Omit CORS_ORIGIN for same-origin hosting; if supplied, exact approved apiOrigin.
# Leave PORT provider-managed. No *_EMULATOR_HOST variables.
# Omit FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY when using the credential file.
# Omit GCLOUD_PROJECT/GOOGLE_CLOUD_PROJECT, or match FIREBASE_PROJECT_ID exactly.
