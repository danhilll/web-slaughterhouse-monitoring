# Copy to .env and fill in from Firebase Console > Project Settings > Your apps > Web app.
# These VITE_ values identify the public web app. Never put an Admin SDK private key in a VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=com-slaughterhouse-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=com-slaughterhouse-app
VITE_FIREBASE_STORAGE_BUCKET=com-slaughterhouse-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server only (Express API) ---
# The API refuses to start without Firestore access and at least one admin UID.
FIREBASE_PROJECT_ID=com-slaughterhouse-app
# Comma-separated Firebase Authentication UIDs of web administrators (two or more are supported).
WEB_ADMIN_UIDS=
# Option 1: point at an Admin SDK service-account JSON file outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\slaughterhouse-service-account.json
# Option 2: inline service-account fields (keep .env private; escape newlines as \n).
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# PORT=5001
# Comma-separated CORS allowlist for production.
# CORS_ORIGIN=https://your-app.web.app
