# Copy to .env and fill in from Firebase console:
# Project Settings > General > Your apps > Web app (project: com-slaughterhouse-app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=com-slaughterhouse-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=com-slaughterhouse-app
VITE_FIREBASE_STORAGE_BUCKET=com-slaughterhouse-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server (Express API, server/index.js) ---
# Without these, the API uses the in-memory seed store (local dev).
# With them, it uses Firestore in project com-slaughterhouse-app.
# Option 1 (recommended locally): point at a service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\slaughterhouse-service-account.json
# Option 2: inline service-account fields (escape newlines in the key as \n).
# FIREBASE_PROJECT_ID=com-slaughterhouse-app
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# PORT=5001
# Comma-separated CORS allowlist for production (empty = open, local dev).
# CORS_ORIGIN=https://your-app.web.app
